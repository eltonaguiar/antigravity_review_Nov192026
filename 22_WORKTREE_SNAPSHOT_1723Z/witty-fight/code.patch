+def _canonical_payload(rows, kept, **summary):
+    payload = _payload(rows, **summary)
+    payload["resolved_closed_picks_net"] = {
+        "schema": "audit.canonical.v1",
+        "rows_sha256": "deadbeef",
+        "counts": {"kept_rows": kept,
+                   "excluded_by_reason": {"invalid_row": 100}},
+    }
+    return payload
+
+
+def _set_canonical(kept: int) -> None:
+    import alpha_engine.audit3_tribunal as trib
+    trib.LAST_DENOMINATOR.clear()
+    trib.LAST_DENOMINATOR.update({"mode": "canonical", "kept_rows": kept,
+                                  "rows_sha256": "deadbeef"})
+
+
+def test_scored_rows_above_valid_never_publish_over_100_pct():
+    """8605 scored vs 8175 'valid closed' used to print 105.26%.
+
+    2026-11-19 live ledger did exactly that. A ratio above 100% means the two
+    denominators disagree, so the headline ratio must be withheld and the raw
+    value plus a reconciliation kept for auditors.
+    """
+    rows = [_row() for _ in range(860)]
+    payload = _canonical_payload(
+        rows, 860,
+        total_closed_picks=14632, valid_closed_picks=817,
+        integrity_excluded=5935, auto_expired_excluded=9110,
+        zero_pnl_count=134,
+        resolver_anomalies={"expired_zero_pnl_rows": 3481},
+    )
+    _set_canonical(860)
+    try:
+        cov = payload_coverage(payload, rows)
+    finally:
+        import alpha_engine.audit3_tribunal as trib
+        trib.LAST_DENOMINATOR.clear()
+
+    assert cov["denominator"]["mode"] == "canonical"
+    assert cov["scored_share_of_valid_pct"] is None
+    assert cov["scored_share_of_valid_pct_raw"] > 100
+    assert cov["valid_denominator_inconsistent"] is True
+    assert cov["denominator_reconciliation"]["delta"] == 43
+    assert cov["denominator_reconciliation"]["scored_but_not_dashboard_valid"] == 43
+    assert cov["denominator_reconciliation"]["consistent"] is False
+    assert "Denominator check" in cov["statement"]
+
+
+def test_auto_expired_wording_matches_canonical_reality():
+    """Timeouts are retained at their resolved exit in the canonical view.
+
+    The old text claimed auto-expired rows are "dropped before scoring and never
+    counted"; the live canonical book still carries zero-P&L rows, so that claim
+    was false. The cohort reason and statement must say so in canonical mode.
+    """
+    rows = [_row() for _ in range(50)]
+    payload = _canonical_payload(
+        rows, 50, total_closed_picks=1000, valid_closed_picks=900,
+        integrity_excluded=300, auto_expired_excluded=400, zero_pnl_count=7)
+    _set_canonical(50)
+    try:
+        cov = payload_coverage(payload, rows)
+    finally:
+        import alpha_engine.audit3_tribunal as trib
+        trib.LAST_DENOMINATOR.clear()
+
+    expired = [c for c in cov["excluded_cohorts"] if c["cohort"] == "auto_expired"][0]
+    assert "retained in the canonical view" in expired["reason"]
+    assert "zero P&L" in expired["reason"]
+    assert "never counted" not in cov["statement"]
+    assert "only partly absent" in cov["statement"]
+
+
+def test_payload_slice_mode_keeps_strict_auto_expired_wording():
+    rows = [_row() for _ in range(5)]
+    cov = payload_coverage(
+        _payload(rows, total_closed_picks=1000, valid_closed_picks=900,
+                 integrity_excluded=300, auto_expired_excluded=400), rows)
+    expired = [c for c in cov["excluded_cohorts"] if c["cohort"] == "auto_expired"][0]
+    assert "dropped before scoring" in expired["reason"]
+    assert cov["denominator"]["mode"] == "payload_slice"
+
+
+def test_summary_candidate_counts_match_each_table():
+    """The KPI used to count strategy cells only while a symbol CANDIDATE existed.
+
+    Live 2026-11-19 ledger: n_candidate=0 but the symbols table carried
+    AUDJPY LONG as CANDIDATE. Each headline count must equal its own table so the
+    page cannot contradict itself.
+    """
+    rows = [_row(strategy=f"s{i % 3}", symbol="BTCUSDT",
+                 pnl_pct=1.0 if i % 2 == 0 else -0.4,
+                 closed_at=f"2026-11-{1 + i % 20:02d}T00:00:00Z")
+            for i in range(48)]
+    rep = build_report(rows, "x", None)
+    s = rep["summary"]
+    assert s["n_candidate"] == sum(1 for c in rep["cells"] if c["verdict"] == "CANDIDATE")
+    assert s["n_candidate_symbols"] == sum(
+        1 for c in rep["symbols"] if c["verdict"] == "CANDIDATE")
+    assert s["n_candidate_segments"] == sum(
+        1 for c in rep["segments"] if c["verdict"] == "CANDIDATE")
