+async function fetchJsonWithFallback(paths){
+  let last = null;
+  for (const p of paths){
+    try {
+      const r = await fetch(p, {cache:'no-store'});
+      if (!r.ok){ last = new Error('HTTP '+r.status+' at '+p); continue; }
+      return await r.json();
+    } catch(e){ last = e; }
+  }
+  throw last || new Error('not found in any known location');
+}
+
+// The page ships at /audit3/ live, where the sidecars sit beside index.html.
+// In the repo they live in audit_dashboard/data/, so local static serving and
+// the historical /audit/ layout are tried too instead of failing on one 404.
+fetchJsonWithFallback(['audit3_evidence.json', 'data/audit3_evidence.json',
+                       '../audit/data/audit3_evidence.json'])
   .then(renderEvidence)
   .catch(err=>{ if($('evSub')) $('evSub').textContent =
     'Evidence registry not published yet ('+err.message+'). The weekly audit3-evidence workflow writes it.'; });
 
